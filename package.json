{
  "name": "theme-github-next",
  "version": "1.1.5",
  "private": true,
  "description": "A GitHub-inspired Halo theme, forked from dengchuanfu/halo-theme-github.",
  "author": "ydzydzydz",
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-messages.mjs && node scripts/sync-version.mjs && node scripts/clean-build.mjs && tsc && vp build && theme-package",
    "build-only": "node scripts/gen-messages.mjs && tsc && vp build",
    "clean": "node scripts/clean-build.mjs",
    "dev": "vp build --watch",
    "check": "node scripts/gen-messages.mjs --check && node scripts/check-i18n.mjs && node scripts/check-js-i18n.mjs && vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "prepare": "vp config",
    "gen:messages": "node scripts/gen-messages.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "skills:update": "npx skills update"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "iconify-icon": "^3.0.2",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.0.1",
    "@halo-dev/vite-plugin-halo-theme": "^1.0.3",
    "@types/node": "18.11.9",
    "sass": "^1.108.1",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.19",
    "vite-plus": "0.1.19"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.1.19"
    }
  }
}
