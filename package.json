{
  "name": "theme-github-next",
  "version": "1.1.0",
  "private": true,
  "description": "A GitHub-inspired Halo theme, forked from dengchuanfu/halo-theme-github.",
  "author": "ydzydzydz",
  "type": "module",
  "scripts": {
    "build": "tsc && vp build && theme-package",
    "build-only": "tsc && vp build",
    "dev": "vp build --watch",
    "check": "vp check --fix",
    "format": "vp fmt",
    "prepare": "vp config",
    "skills:update": "npx skills update"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "iconify-icon": "^3.0.2",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.0.1",
    "@halo-dev/vite-plugin-halo-theme": "^1.0.3",
    "@types/node": "18.11.9",
    "sass": "^1.108.1",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
